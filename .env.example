# Copy to .env and adjust. NEVER commit real secrets.
DB_URL=jdbc:postgresql://127.0.0.1:5433/zevora
DB_USERNAME=zevora
DB_PASSWORD=zevora_dev
SERVER_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_MODE=true
SEED_DEMO=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
PLATFORM_FEE_PERCENT=5

# Web
VITE_API_URL=http://localhost:8080/api/v1

# Mobile (Expo) - use 10.0.2.2 for Android emulator, LAN IP for a phone
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
